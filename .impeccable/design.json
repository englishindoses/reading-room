  "components": [
    {
      "name": "Library feature panel",
      "kind": "card",
      "refersTo": "feature-panel",
      "description": "Forest feature surface with cream text and honey greeting.",
      "html": "<section class=\"ds-feature\"><h1>Your next chapter starts here.</h1><p>A little further, one page at a time.</p><p class=\"ds-greeting\">Welcome to your reading room</p></section>",
      "css": ".ds-feature{padding:22px;border-radius:16px;background:var(--feature,#183f32);color:var(--feature-ink,#fff3d7);font:16px/1.5 \"Segoe UI\",system-ui,sans-serif}.ds-feature h1{font-size:1.875rem;font-weight:650;line-height:1.15;letter-spacing:-.035em;max-width:26ch;margin:0 0 10px}.ds-feature p{color:var(--feature-muted,#e9dcc4);margin:0}.ds-feature .ds-greeting{margin-top:14px;font-size:.875rem;font-weight:600;color:var(--honey,#f1be59)}@media(min-width:600px){.ds-feature{padding:32px 36px}.ds-feature h1{font-size:2.5rem}.ds-feature .ds-greeting{margin-top:20px}}@media(min-width:960px){.ds-feature{padding:36px 40px}.ds-feature h1{font-size:2.75rem;max-width:29ch}}"
    },
    {
      "name": "Collapsed reader dock",
      "kind": "nav",
      "description": "Save status and navigation handle share one centered row at all widths; page index and main links appear on expansion.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Reading navigation\"><p class=\"ds-save\" role=\"status\">Saved on this device</p><button class=\"ds-handle\" aria-expanded=\"false\">Open navigation</button></nav>",
      "css": ".ds-dock{display:flex;align-items:center;justify-content:center;gap:8px;padding:8px 12px calc(8px + env(safe-area-inset-bottom));font-family:'Segoe UI',system-ui,sans-serif}.ds-save{margin:0;width:auto;max-width:45%;padding:4px 10px;background:var(--surface,#fffcf4);border-radius:6px;color:var(--muted,#705b43);font-size:.75rem;line-height:1.5;text-align:center}.ds-handle{margin:0;display:flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 16px;border:1px solid var(--line,#d5bea0);border-radius:8px;background:var(--surface,#fffcf4);color:var(--ink,#24382c);font:600 .75rem/1.5 'Segoe UI',system-ui,sans-serif;box-shadow:0 12px 32px #573a1712;cursor:pointer;transition:background .16s,color .16s}.ds-handle:hover{background:var(--tint,#e1e8d1)}.ds-handle:focus-visible{outline:3px solid #975114;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-handle{transition:none}}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action with shared focus and disabled treatment.",
      "html": "<button class=\"ds-primary\">Start reading</button>",
      "css": ".ds-primary{font:600 16px/1.5 'Segoe UI',system-ui,sans-serif;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;background:var(--accent,#20513d);color:#fff;cursor:pointer;transition:background .16s,color .16s}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#153b2b)}.ds-primary:focus-visible{outline:3px solid #975114;outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Reading paper",
      "kind": "card",
      "refersTo": "reader-paper",
      "description": "Serif reading surface with responsive padding.",
      "html": "<article class=\"ds-paper\"><div class=\"ds-rule\"></div><h1>A quiet morning</h1><p>The room was warm.<br>A book waited on the table.</p></article>",
      "css": ".ds-paper{background:var(--surface,#fffcf4);color:var(--ink,#24382c);padding:28px 22px;border-radius:12px;box-shadow:0 12px 32px #573a1712;min-height:410px}.ds-paper h1{font:400 2rem/1.15 Georgia,serif;letter-spacing:-.035em;margin:12px 0 30px}.ds-paper p{font:1.35rem/2 Georgia,'Times New Roman',serif;max-width:40ch;white-space:pre-line}.ds-rule{width:56px;height:3px;border-radius:2px;background:var(--warm,#ab482e);margin:6px 0 26px}@media(min-width:600px){.ds-paper{padding:42px 48px;min-height:460px}.ds-paper h1{font-size:2.5rem}.ds-paper p{font-size:1.6rem}}@media(min-width:960px){.ds-paper{padding:48px 64px}}"
    },
    {
      "name": "Answer option",
      "kind": "input",
      "description": "Native radio option with selected and keyboard focus states.",
      "html": "<label class=\"ds-answer\"><input type=\"radio\" name=\"ds-answer\" checked>In the reading room</label>",
      "css": ".ds-answer{display:flex;align-items:center;gap:12px;border:1px solid var(--line,#d5bea0);border-radius:8px;padding:14px;min-height:48px;font:.95rem/1.5 'Segoe UI',system-ui,sans-serif;color:var(--ink,#24382c);cursor:pointer}.ds-answer input{width:19px;height:19px;accent-color:var(--accent,#20513d)}.ds-answer:has(input:checked){background:var(--tint,#e1e8d1);border-color:var(--accent,#20513d);box-shadow:inset 0 0 0 1px var(--accent,#20513d)}.ds-answer input:focus-visible{outline:3px solid #975114;outline-offset:4px}"
