      "kind": "nav",
      "description": "Save status and navigation handle share one centered row at all widths; page index and main links appear on expansion.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Reading navigation\"><p class=\"ds-save\" role=\"status\">Saved on this device</p><button class=\"ds-handle\" aria-expanded=\"false\">Open navigation</button></nav>",
      "css": ".ds-dock{display:flex;align-items:center;justify-content:center;gap:8px;padding:8px 12px calc(8px + env(safe-area-inset-bottom));font-family:'Segoe UI',system-ui,sans-serif}.ds-save{margin:0;width:auto;max-width:45%;padding:4px 10px;background:var(--surface,#fffefb);border-radius:6px;color:var(--muted,#5e6c63);font-size:.75rem;line-height:1.5;text-align:center}.ds-handle{margin:0;display:flex;align-items:center;justify-content:center;gap:9px;min-height:40px;padding:10px 16px;border:1px solid var(--line,#d8ddd1);border-radius:8px;background:var(--surface,#fffefb);color:var(--ink,#243b34);font:600 .75rem/1.5 'Segoe UI',system-ui,sans-serif;box-shadow:0 12px 36px #233c3315;cursor:pointer;transition:background .16s,color .16s}.ds-handle:hover{background:var(--tint,#e7ede3)}.ds-handle:focus-visible{outline:3px solid #b97428;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-handle{transition:none}}"
    },
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action with shared focus and disabled treatment.",
      "html": "<button class=\"ds-primary\">Start reading</button>",
      "css": ".ds-primary{font:600 16px/1.5 'Segoe UI',system-ui,sans-serif;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:8px;background:var(--accent,#254e43);color:#fff;cursor:pointer;transition:background .16s,color .16s}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#193a31)}.ds-primary:focus-visible{outline:3px solid #b97428;outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
