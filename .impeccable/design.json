      "name": "Character avatars",
      "kind": "custom",
      "html": "<div class=\"ds-avatar-grid\"><label class=\"ds-avatar-choice\"><input type=\"radio\" name=\"ds-avatar\" checked><img src=\"assets/avatars/character-1.webp\" alt=\"Maya\"><span>Maya</span></label><label class=\"ds-avatar-choice\"><input type=\"radio\" name=\"ds-avatar\"><img src=\"assets/avatars/character-8.webp\" alt=\"Kenji\"><span>Kenji</span></label><label class=\"ds-avatar-choice\"><input type=\"radio\" name=\"ds-avatar\"><img src=\"assets/avatars/character-9.webp\" alt=\"Rose\"><span>Rose</span></label></div>",
      "css": ".ds-avatar-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;font:600 13px/1.5 system-ui}.ds-avatar-choice{position:relative;display:flex;flex-direction:column;align-items:center;gap:7px;padding:10px 6px;border:1px solid #d5bea0;border-radius:12px;background:#fffcf4;cursor:pointer}.ds-avatar-choice img{width:72px;height:72px;border-radius:50%;object-fit:cover}.ds-avatar-choice input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}.ds-avatar-choice:has(input:checked){background:#e1e8d1;border-color:#20513d;box-shadow:inset 0 0 0 1px #20513d}.ds-avatar-choice:has(input:focus-visible){outline:3px solid #975114;outline-offset:4px}"
